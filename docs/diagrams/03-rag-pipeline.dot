digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.7", fontname="Segoe UI", fontsize=20, labelloc="t", label="Cortex AI — retrieval and grounded answering\nPHASE 2 PLAN · NOT IMPLEMENTED"]; node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=12, margin="0.2,0.15", color="#8190a8", fontcolor="#182238", penwidth=1.2]; edge [fontname="Segoe UI", fontsize=10, color="#62738b", fontcolor="#334155", arrowsize=0.7];
subgraph cluster_workflow {label="PROPOSED WORKFLOW / RELATED ENTITIES";fontsize=10;color="#dce2eb";style="rounded";
q [label="Question + explicit as-of + scope",fillcolor="#f1f5f9"];
id [label="Authenticated identity\nQuery action permission",fillcolor="#e7edff"];
acl [label="SQL tenant + READ filtering\nCandidate IDs only",fillcolor="#e7edff"];
time [label="Approval + validity + scope\nReject uncertain metadata",fillcolor="#def4ed"];
rank [label="Authorized text hydration\nToken coverage rank",fillcolor="#def4ed"];
peer [label="Expand all permitted claim peers\nCap overflow → abstain",fillcolor="#fff1d6"];
conf [label="Authority + conflict comparison",fillcolor="#fff1d6"];
select [label="Select supporting clauses\nOr safe abstention",fillcolor="#def4ed"];
ans [label="Offline evidence answerer\nOptional local AI in B",fillcolor="#e7edff"];
check [label="Citation spans + hashes\nCurrent ACL + revisions",fillcolor="#def4ed"];
res [label="Answer / abstain / clarify\nOnly permitted explanation",fillcolor="#f1f5f9"];
}
q -> id [label="1"];
id -> acl [label="2"];
