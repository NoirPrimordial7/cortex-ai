digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.7", fontname="Segoe UI", fontsize=20, labelloc="t", label="Cortex AI — end-to-end application data flow\nPHASE 2 PLAN · NOT IMPLEMENTED"]; node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=12, margin="0.2,0.15", color="#8190a8", fontcolor="#182238", penwidth=1.2]; edge [fontname="Segoe UI", fontsize=10, color="#62738b", fontcolor="#334155", arrowsize=0.7];
subgraph cluster_workflow {label="PROPOSED WORKFLOW / RELATED ENTITIES";fontsize=10;color="#dce2eb";style="rounded";
user [label="Employee or knowledge manager",fillcolor="#f1f5f9"];
auth [label="Authenticate + authorize action",fillcolor="#e7edff"];
upload [label="Upload route\nQuarantine + extraction",fillcolor="#e7edff"];
review [label="Review ACL + approval\nValidity + claims + authority",fillcolor="#fff1d6"];
index [label="Immutable knowledge generation",fillcolor="#eef0f4"];
query [label="Query route\nPermission-filtered IDs",fillcolor="#e7edff"];
valid [label="Approved date + scope eligibility",fillcolor="#def4ed"];
analysis [label="Rank + authorized peer analysis",fillcolor="#fff1d6"];
out [label="Verify + current ACL recheck\nAnswer / abstention + citations",fillcolor="#def4ed"];
}
user -> auth [label="session"];
auth -> upload [label="upload action"];
upload -> review [label="pending evidence"];
review -> index [label="atomic publish"];
auth -> query [label="query action"];
index -> query [label="current grants / IDs"];
query -> valid [label="eligible IDs"];
valid -> analysis [label="authorized text only"];
analysis -> out [label="decision"];
out -> user [label="permitted result"];
}
