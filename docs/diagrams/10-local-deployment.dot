digraph G { graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.7", fontname="Segoe UI", fontsize=20, labelloc="t", label="Cortex AI — local development and demonstration\nPHASE 2 PLAN · NOT IMPLEMENTED"]; node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=12, margin="0.2,0.15", color="#8190a8", fontcolor="#182238", penwidth=1.2]; edge [fontname="Segoe UI", fontsize=10, color="#62738b", fontcolor="#334155", arrowsize=0.7];
subgraph cluster_client {label="USER SURFACE";fontsize=10;color="#dce2eb";style="rounded";
dev [label="Development browser", fillcolor="#f1f5f9"];
demo [label="Demo browser\nSame-origin application", fillcolor="#f1f5f9"];
}
subgraph cluster_app {label="APPLICATION / TRUSTED CONTROL";fontsize=10;color="#dce2eb";style="rounded";
vite [label="Vite localhost\nFrontend + /api proxy", fillcolor="#e7edff"];
api [label="Single FastAPI localhost process\nBuilt assets + /api/v1 + tenant gates", fillcolor="#e7edff"];
parser [label="Bounded child parser\nPDF / DOCX / TXT", fillcolor="#e7edff"];
}
subgraph cluster_store {label="LOCAL STORAGE";fontsize=10;color="#dce2eb";style="rounded";
db [label="Local SQLite\nRollback journal baseline", fillcolor="#eef0f4"];
disk [label="Private upload / quarantine paths\nOutside public assets + Git", fillcolor="#eef0f4"];
}
subgraph cluster_decision {label="REVIEW / DECISION";fontsize=10;color="#dce2eb";style="rounded";
optional [label="Optional loopback model server\nDisabled A; no paid provider", fillcolor="#fff1d6"];
}
dev -> vite [label="HTTP loopback only"];
vite -> api [label="proxy"];
demo -> api [label="same-origin cookie"];
