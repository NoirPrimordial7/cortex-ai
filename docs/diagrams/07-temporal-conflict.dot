digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.7", fontname="Segoe UI", fontsize=20, labelloc="t", label="Cortex AI — temporal validity and conflict decisions\nPHASE 2 PLAN · NOT IMPLEMENTED"]; node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=12, margin="0.2,0.15", color="#8190a8", fontcolor="#182238", penwidth=1.2]; edge [fontname="Segoe UI", fontsize=10, color="#62738b", fontcolor="#334155", arrowsize=0.7];
subgraph cluster_workflow {label="PROPOSED WORKFLOW / RELATED ENTITIES";fontsize=10;color="#dce2eb";style="rounded";
allowed [label="Authorized candidates + requested date",fillcolor="#def4ed"];
valid [label="Approved + exact scope\nvalid_from ≤ date < valid_to",fillcolor="#fff1d6"];
none [label="No eligible evidence\nSafe abstention",fillcolor="#f1f5f9"];
key [label="Reviewed claim key matches?",fillcolor="#fff1d6"];
uncertain [label="Uncertain / unsupported\nClarify or abstain",fillcolor="#f1f5f9"];
lineage [label="Apply reviewed amendment boundary\nDifferent scope / date is not conflict",fillcolor="#def4ed"];
authority [label="Select strongest topic authority\nExpand all applicable peers",fillcolor="#fff1d6"];
agree [label="Strongest values agree?",fillcolor="#fff1d6"];
answer [label="Answer + supporting citations\nReadable lower-rank note optional",fillcolor="#def4ed"];
conflict [label="Equal strongest values disagree\nCited conflict abstention",fillcolor="#fff1d6"];
}
allowed -> valid [label=""];
valid -> none [label="none"];
valid -> key [label="eligible"];
key -> uncertain [label="no / ambiguous"];
key -> lineage [label="yes"];
lineage -> authority [label=""];
authority -> agree [label=""];
agree -> answer [label="yes"];
agree -> conflict [label="no"];
}
