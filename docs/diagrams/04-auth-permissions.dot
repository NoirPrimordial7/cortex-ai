digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.7", fontname="Segoe UI", fontsize=20, labelloc="t", label="Cortex AI — authentication and permission flow\nPHASE 2 PLAN · NOT IMPLEMENTED"]; node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=12, margin="0.2,0.15", color="#8190a8", fontcolor="#182238", penwidth=1.2]; edge [fontname="Segoe UI", fontsize=10, color="#62738b", fontcolor="#334155", arrowsize=0.7];
subgraph cluster_workflow {label="PROPOSED WORKFLOW / RELATED ENTITIES";fontsize=10;color="#dce2eb";style="rounded";
request [label="Request + opaque session cookie",fillcolor="#f1f5f9"];
session [label="Valid session + active user?",fillcolor="#fff1d6"];
noauth [label="401 generic authentication failure",fillcolor="#f1f5f9"];
action [label="Role permits requested action?",fillcolor="#fff1d6"];
deny [label="403 operation denied",fillcolor="#f1f5f9"];
tenant [label="Trusted tenant + explicit current READ grant?",fillcolor="#fff1d6"];
hidden [label="404 unavailable\nNo title / existence disclosure",fillcolor="#f1f5f9"];
ids [label="Filtered candidate IDs\nThen date / approval / scope",fillcolor="#def4ed"];
text [label="Authorized evidence only\nRerank / conflicts / optional model",fillcolor="#def4ed"];
revision [label="Recheck ACL + revisions before output",fillcolor="#fff1d6"];
safe [label="Permitted response\nOr CONTEXT_CHANGED abstention",fillcolor="#f1f5f9"];
}
request -> session [label=""];
session -> noauth [label="no"];
session -> action [label="yes"];
action -> deny [label="no"];
action -> tenant [label="yes"];
tenant -> hidden [label="no / direct object"];
tenant -> ids [label="yes"];
ids -> text [label="eligible"];
text -> revision [label=""];
revision -> safe [label="never stale context"];
}
